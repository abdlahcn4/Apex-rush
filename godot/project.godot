; Apex Rush - Godot vertical slice
; Generated from the Three.js sources in multiplayer-3d-racing-game.zip

config_version=5

[application]

config/name="Apex Rush - Godot Slice"
config/description="Sunset Ring circuit + Vortex GT. Ported from the Three.js build."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
; vsync on, so the chase camera tears less on a desktop monitor
window/vsync/vsync_mode=1

[rendering]

; OpenGL for every platform. Forward+ needs a working Vulkan driver, and on Windows a
; missing or broken Vulkan driver makes the window close instantly with no message -
; which is exactly what happened on the player's PC. GL compatibility also has an ANGLE
; (D3D11) fallback, so it starts on almost any machine. Pass
; --rendering-method forward_plus on the command line to opt into Vulkan.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; try ANGLE when native OpenGL is unavailable (Windows)
gl_compatibility/fallback_to_angle=true
anti_aliasing/quality/msaa_3d=2
; 16x anisotropic filtering: keeps the asphalt and grass crisp down the straight
textures/default_filters/anisotropic_filtering_level=3
; required by the Android exporter (Godot refuses to export without it)
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.16, 0.2, 0.28, 1)

[input_devices]

; Android delivers raw touch only. Godot's Button/Control widgets are driven by mouse
; events, so without this every tap on the menu is swallowed and the game is unusable
; on a phone. The on-screen driving layer filters the emulated duplicates itself.
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
